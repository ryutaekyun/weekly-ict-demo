# PostgreSQL 연결 문자열 (운영/Docker 기본값)
DATABASE_URL=postgresql+psycopg2://tnp:tnp_password@db:5432/tnp_platform

# JWT 서명 비밀키 — 반드시 운영 환경에서 재생성할 것 (openssl rand -hex 32)
JWT_SECRET=change-me-in-production

JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Next.js 프런트엔드 Origin (콤마로 구분)
CORS_ORIGINS=["http://localhost:3000"]

# --- Phase 2-2: AI 분류·추출 연동(선택) ---
# 둘 다 비워 두면 AI를 호출하지 않고 규칙 기반(키워드 매칭)으로만 동작한다.
# AI_PROVIDER=anthropic           # anthropic | openai
# AI_MODEL=claude-sonnet-5-5      # 비워 두면 공급자별 기본 모델 사용
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
