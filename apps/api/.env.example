# PostgreSQL 연결 문자열 (운영/Docker 기본값)
DATABASE_URL=postgresql+psycopg2://tnp:tnp_password@db:5432/tnp_platform

# JWT 서명 비밀키 — 반드시 운영 환경에서 재생성할 것 (openssl rand -hex 32)
JWT_SECRET=change-me-in-production

JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Next.js 프런트엔드 Origin (콤마로 구분)
CORS_ORIGINS=["http://localhost:3000"]

# --- Phase 2-2: AI 분류·추출 연동(선택) ---
# 둘 다 비워 두면 AI를 호출하지 않고 규칙 기반(키워드 매칭)으로만 동작한다.
# AI_PROVIDER=anthropic           # anthropic | openai
# AI_MODEL=claude-sonnet-5-5      # Anthropic은 비워 두면 claude-sonnet-5-5(공식 모델 문서 2026-10-27 확인). OpenAI는 기본 모델이 없어 반드시 지정
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# Phase 3-6 AI 분석(연구원이 웹에서 명시적으로 요청) — 위 공급자·키가 모두 설정돼야 실행된다(미설정이면 'AI 설정 필요'만 표시, 가짜 결과 없음)
# AI_DAILY_LIMIT=30                 # 사용자별 하루 AI 분석 호출 한도
# 토큰 단가는 환경변수가 아니라 설정 화면의 관리자 단가표(ai_price_settings)에서 관리한다(요금 기준일·버전 기록)
# 개발·자동 테스트 전용 모의 공급자(실제 AI 아님, 결과에 '모의 응답' 표시): AI_PROVIDER=mock AI_ALLOW_MOCK=1 (AI_MOCK_FLAWS=1이면 검증 실패 시연 문장 포함)
# Phase 3-6.2A 첫 실제 호출 안전장치
# AI_REQUIRE_APPROVAL=1             # 기본 1: 실제(비모의) 호출은 관리자의 1건 승인(대상·모델·예산 상한, 1회용)이 있어야 실행 — 0으로만 끌 수 있음
# AI_MAX_COST_PER_REQUEST_USD=0.30  # 요청당 전역 예산 상한(예상 비용이 넘으면 호출 전에 차단)
# AI_STRUCTURED_OUTPUT=1            # Anthropic 구조화 출력(output_config.format json_schema) — 실호출 검증 전에는 켜지 않음
# 자세한 설정·보안 절차는 docs/AI_SETUP.md 참고
